# Copy to an operator-local .env; never commit real values.
# Secrets: generate or retrieve through the approved secret store.
TRAVELPAYOUTS_TOKEN=
TELEGRAM_BOT_TOKEN=
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=

# Database connection string contains a password; treat the complete URL as secret.
# Compose hostname is db. Use a separate disposable database for staging/tests.
DATABASE_URL=
POSTGRES_USER=travelltickets
POSTGRES_DB=travelltickets

# Public/non-secret runtime configuration (identifiers are environment-specific).
ADMIN_USERNAME=admin
SESSION_COOKIE_NAME=travelltickets_session
APP_BASE_URL=http://localhost:5000
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_URL=
TELEGRAM_CHAT_ID=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_WEBSITE_PROJECT_ID=
TRAVELPAYOUTS_TELEGRAM_PROJECT_ID=
DEBUG_MONITORING_MESSAGES=false
